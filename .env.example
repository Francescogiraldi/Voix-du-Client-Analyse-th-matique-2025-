# Voix du Client Configuration
# Copy this file to .env and adjust values as needed

# NLP Configuration
VOIX_NLP_MODEL=fr_core_news_sm
VOIX_MAX_FEATURES=5000
VOIX_NGRAM_RANGE_MIN=1
VOIX_NGRAM_RANGE_MAX=2

# Clustering Configuration
VOIX_DEFAULT_K=5
VOIX_MIN_K=2
VOIX_MAX_K=15
VOIX_RANDOM_STATE=42

# Text Processing
VOIX_MIN_TEXT_LENGTH=10

# File Paths
VOIX_DATA_DIR=data
VOIX_MODELS_DIR=models
VOIX_LOGS_DIR=logs

# Streamlit Configuration
VOIX_PAGE_TITLE=Voix du Client
VOIX_PAGE_ICON=💬
VOIX_LAYOUT=wide

# Logging
VOIX_LOG_LEVEL=INFO

# Performance
VOIX_CACHE_TTL=3600
VOIX_MAX_FILE_SIZE_MB=50

# Visualization
VOIX_WORDCLOUD_WIDTH=800
VOIX_WORDCLOUD_HEIGHT=400
VOIX_WORDCLOUD_BACKGROUND=white
VOIX_TOP_TERMS_DISPLAY=10